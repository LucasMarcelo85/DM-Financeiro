// Banco de dados do DM Financeiro (PostgreSQL).
// Para criar/atualizar as tabelas: npm run db:deploy
// Para alterar este arquivo e gerar nova migração em desenvolvimento: npm run db:migrate

generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserKind {
  PF
  PJ
}

enum Role {
  usuario
  admin
}

enum PaymentStatus {
  pending
  paid
}

// Para que a conexão do WhatsApp serve: enviar cobranças/lembretes ou apenas auditar conversas.
enum InstancePurpose {
  envio
  auditoria
}

// Como o WhatsApp foi conectado: QR Code (Evolution API) ou API oficial da Meta (Cloud API).
enum InstanceProvider {
  evolution
  meta
}

enum MessageKind {
  cobranca
  lembrete
}

enum MessageStatus {
  sent
  partial
  failed
}

enum Recurrence {
  avulsa
  mensal
}

enum ScheduleStatus {
  ativa
  pausada
  concluida
}

model User {
  id           Int       @id @default(autoincrement())
  kind         UserKind
  name         String
  document     String    @unique
  email        String    @unique
  phone        String    @default("")
  passwordHash String    @map("password_hash")
  role         Role      @default(usuario)
  plan         String    @default("bronze") // id de um plano da tabela plan_settings
  trialEndsAt  DateTime  @map("trial_ends_at")
  accessUntil  DateTime? @map("access_until")
  createdAt    DateTime  @default(now()) @map("created_at")
  // Última vez que o usuário mexeu em algo (qualquer alteração, não só abrir telas) e em qual área.
  lastActivityAt DateTime? @map("last_activity_at")
  lastActivity   String?   @map("last_activity")
  // Endereço público do portfólio (dominio/<portfolioSlug>), feito do nome/razão social. Criado na 1ª página.
  portfolioSlug  String?   @unique @map("portfolio_slug")
  // Código PIN opcional (guardado com hash) e as abas do menu que ele protege (chaves em server/utils/pin.js).
  pinHash        String?   @map("pin_hash")
  pinTabs        String[]  @default([]) @map("pin_tabs")

  instances Instance[]
  payments  Payment[]
  contacts  Contact[]
  schedules       Schedule[]
  messages        Message[]
  billingPayments BillingPayment[]
  contracts       Contract[]
  portfolios      Portfolio[]
  auditChats      AuditChat[]
  auditLabels     AuditLabel[]
  accessEvents    AccessEvent[]
  verificationCodes VerificationCode[]
  products        Product[]
  orders          Order[]
  catalogSettings CatalogSettings?

  @@map("users")
}

model Instance {
  id        Int              @id @default(autoincrement())
  userId    Int              @map("user_id")
  name      String           @unique
  purpose   InstancePurpose  @default(envio)
  provider  InstanceProvider @default(evolution)
  // Nome amigável (ex.: "Atendimento"). Opcional.
  label     String?
  // Campos da API oficial da Meta (só usados quando provider = meta).
  // Os segredos ficam criptografados (ver server/utils/secret.js) e nunca voltam para o navegador.
  metaPhoneNumberId String? @map("meta_phone_number_id")
  metaBusinessId    String? @map("meta_business_id")
  metaAccessToken   String? @map("meta_access_token")
  metaAppSecret     String? @map("meta_app_secret")
  metaVerifyToken   String? @map("meta_verify_token")
  metaPhoneDisplay  String? @map("meta_phone_display")
  // Auditoria: última sincronização completa feita pelo servidor e último evento recebido por webhook.
  lastSyncAt  DateTime? @map("last_sync_at")
  lastEventAt DateTime? @map("last_event_at")
  createdAt DateTime         @default(now()) @map("created_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  schedules     Schedule[]
  auditChats    AuditChat[]
  auditContacts AuditContact[]

  @@index([userId, purpose])
  @@index([metaPhoneNumberId])
  @@map("instances")
}

model Payment {
  id             Int           @id @default(autoincrement())
  userId         Int           @map("user_id")
  orderNsu       String        @unique @map("order_nsu")
  plan           String
  amountCents    Int           @map("amount_cents")
  // Período contratado (mensal, semestral ou anual) e quantos dias de acesso ele libera.
  period         String        @default("mensal")
  days           Int           @default(30)
  status         PaymentStatus @default(pending)
  slug           String?
  transactionNsu String?       @map("transaction_nsu")
  receiptUrl     String?       @map("receipt_url")
  createdAt      DateTime      @default(now()) @map("created_at")
  paidAt         DateTime?     @map("paid_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("payments")
}

// Clientes salvos pelo usuário (para escolher rápido ao criar cobranças e lembretes).
model Contact {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  name      String
  phone     String
  email     String?
  notes     String?
  // Dados extras do cliente, usados como variáveis nos contratos (ex.: {{cliente.documento}}).
  document   String?
  zip        String?
  street     String?
  number     String?
  complement String?
  district   String?
  city       String?
  state      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  schedules        Schedule[]
  messages         Message[]
  billingPayments  BillingPayment[]

  @@unique([userId, phone])
  @@index([userId, name])
  @@map("contacts")
}

// Cobrança ou lembrete: avulso (uma vez) ou mensal (todo mês), enviado automaticamente.
model Schedule {
  id          Int            @id @default(autoincrement())
  userId      Int            @map("user_id")
  contactId   Int            @map("contact_id")
  instanceId  Int?           @map("instance_id")
  kind        MessageKind
  recurrence  Recurrence
  status      ScheduleStatus @default(ativa)
  amountCents Int?           @map("amount_cents")
  text        String
  extra       String?
  // Vencimento: data exata (avulsa) ou o primeiro vencimento, de onde sai o dia do mês (mensal).
  dueDate     DateTime       @map("due_date") @db.Date
  // Vencimento da próxima ocorrência ainda não enviada.
  nextDueDate DateTime?      @map("next_due_date") @db.Date
  daysBefore  Int            @default(0) @map("days_before")
  sendTime    String         @map("send_time")
  nextRunAt   DateTime?      @map("next_run_at")
  attempts    Int            @default(0)
  lastRunAt   DateTime?      @map("last_run_at")
  lastStatus  MessageStatus? @map("last_status")
  lastError   String?        @map("last_error")
  sentCount   Int            @default(0) @map("sent_count")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  contact         Contact          @relation(fields: [contactId], references: [id], onDelete: Cascade)
  instance        Instance?        @relation(fields: [instanceId], references: [id], onDelete: SetNull)
  messages        Message[]
  billingPayments BillingPayment[]

  @@index([userId, kind])
  @@index([status, nextRunAt])
  @@map("schedules")
}

// Cobrança marcada como paga pelo usuário (uma linha por vencimento pago).
// Alimenta o faturamento (30/60/90 dias ou por datas) e a avaliação em estrelas de cada cliente.
// Se a cobrança ou o cliente forem excluídos, o recebimento continua no histórico (contactName guarda o nome).
model BillingPayment {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  scheduleId  Int?     @map("schedule_id")
  contactId   Int?     @map("contact_id")
  contactName String   @map("contact_name")
  amountCents Int      @map("amount_cents")
  // Vencimento a que o pagamento se refere e o dia em que o cliente realmente pagou.
  dueDate     DateTime @map("due_date") @db.Date
  paidAt      DateTime @map("paid_at") @db.Date
  createdAt   DateTime @default(now()) @map("created_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  schedule Schedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  contact  Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@unique([scheduleId, dueDate])
  @@index([userId, paidAt])
  @@index([userId, contactId])
  @@map("billing_payments")
}

// Histórico de tudo que foi enviado.
model Message {
  id           Int           @id @default(autoincrement())
  userId       Int           @map("user_id")
  contactId    Int?          @map("contact_id")
  scheduleId   Int?          @map("schedule_id")
  contactName  String?       @map("contact_name")
  instanceName String        @map("instance_name")
  kind         MessageKind
  number       String
  hasExtra     Boolean       @default(false) @map("has_extra")
  status       MessageStatus
  error        String?
  automatic    Boolean       @default(false)
  createdAt    DateTime      @default(now()) @map("created_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  contact  Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  schedule Schedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("messages")
}

// Modelos de contrato do usuário (criados no editor ou importados).
// `data` guarda o documento do editor (páginas e elementos) em JSON; a API valida e limpa antes de salvar.
model Contract {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  name      String
  pageCount Int      @default(1) @map("page_count")
  data      Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
  @@map("contracts")
}

// ---------- Portfólio (páginas públicas personalizáveis) ----------
// Endereço: dominio/<User.portfolioSlug> abre a página principal (isMain); as outras abrem em dominio/<portfolioSlug>/<slug>.
// `data` é o documento do editor (tema + blocos), validado em server/utils/portfolio.js.
model Portfolio {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  name      String
  slug      String
  published Boolean  @default(false)
  isMain    Boolean  @default(false) @map("is_main")
  kind      String   @default("site") // 'site' (página livre) ou 'catalog' (catálogo digital)
  data      Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, slug])
  @@index([userId, updatedAt])
  @@map("portfolios")
}

// ---------- Auditoria de conversas ----------
// Uma conversa (contato ou grupo) vista por uma conexão de auditoria. A anotação é um bloco de texto por conversa.
model AuditChat {
  id            Int       @id @default(autoincrement())
  userId        Int       @map("user_id")
  instanceId    Int       @map("instance_id")
  jid           String
  isGroup       Boolean   @default(false) @map("is_group")
  name          String?
  nameSearch    String    @default("") @map("name_search")
  phone         String    @default("")
  note          String    @default("")
  noteUpdatedAt DateTime? @map("note_updated_at")
  lastMessageAt DateTime  @map("last_message_at")
  lastText      String    @default("") @map("last_text")
  lastFromMe    Boolean   @default(false) @map("last_from_me")
  unread        Int       @default(0)
  createdAt     DateTime  @default(now()) @map("created_at")

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  instance Instance        @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  messages AuditMessage[]
  labels   AuditChatLabel[]

  @@unique([instanceId, jid])
  @@index([userId, lastMessageAt])
  @@map("audit_chats")
}

// Mensagem de uma conversa. `search` é o texto sem acentos e em minúsculas, usado na busca por palavra-chave.
model AuditMessage {
  id         Int      @id @default(autoincrement())
  chatId     Int      @map("chat_id")
  externalId String   @map("external_id")
  fromMe     Boolean  @default(false) @map("from_me")
  sender     String?
  senderJid  String?  @map("sender_jid")
  type       String   @default("text")
  body       String   @default("")
  search     String   @default("")
  status     String?
  ts         DateTime
  // Lida = o auditor abriu a conversa, o dono respondeu depois, ou o WhatsApp avisou que foi lida. Só vale para mensagens recebidas.
  seenAt     DateTime? @map("seen_at")
  // Mídia (foto, áudio, vídeo...): o arquivo fica em audit_media; mediaRef = id da mídia na Meta.
  hasMedia     Boolean @default(false) @map("has_media")
  mediaMime    String? @map("media_mime")
  mediaName    String? @map("media_name")
  mediaSeconds Int?    @map("media_seconds")
  mediaRef     String? @map("media_ref")
  thumb        String?
  createdAt  DateTime @default(now()) @map("created_at")

  chat  AuditChat   @relation(fields: [chatId], references: [id], onDelete: Cascade)
  media AuditMedia?

  @@unique([chatId, externalId])
  @@index([chatId, ts])
  @@index([chatId, fromMe, seenAt])
  @@index([ts])
  @@map("audit_messages")
}

// Arquivo de uma mensagem com mídia (guardado depois do primeiro download; as mídias do WhatsApp expiram).
model AuditMedia {
  messageId Int      @id @map("message_id")
  mime      String
  size      Int
  data      Bytes
  createdAt DateTime @default(now()) @map("created_at")

  message AuditMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@map("audit_media")
}

// Nome de cada pessoa que o WhatsApp mostra (contato ou participante de grupo), por conexão.
model AuditContact {
  id         Int      @id @default(autoincrement())
  instanceId Int      @map("instance_id")
  jid        String
  name       String
  updatedAt  DateTime @updatedAt @map("updated_at")

  instance Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@unique([instanceId, jid])
  @@map("audit_contacts")
}

// Etiqueta criada pelo usuário (ex.: "Cliente VIP") para marcar conversas.
model AuditLabel {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  name      String
  color     String   @default("#1f55a6")
  createdAt DateTime @default(now()) @map("created_at")

  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  chats AuditChatLabel[]

  @@unique([userId, name])
  @@map("audit_labels")
}

model AuditChatLabel {
  chatId  Int @map("chat_id")
  labelId Int @map("label_id")

  chat  AuditChat  @relation(fields: [chatId], references: [id], onDelete: Cascade)
  label AuditLabel @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([chatId, labelId])
  @@index([labelId])
  @@map("audit_chat_labels")
}

// Liberações de acesso feitas pelo administrador (mensal ou teste). Guarda o estado de antes e de depois
// para permitir "retroceder" uma liberação feita sem querer.
model AccessEvent {
  id              Int       @id @default(autoincrement())
  userId          Int       @map("user_id")
  adminId         Int?      @map("admin_id")
  adminName       String    @default("") @map("admin_name")
  kind            String // 'mensal' | 'teste'
  days            Int
  prevAccessUntil DateTime? @map("prev_access_until")
  prevTrialEndsAt DateTime  @map("prev_trial_ends_at")
  newAccessUntil  DateTime? @map("new_access_until")
  newTrialEndsAt  DateTime  @map("new_trial_ends_at")
  revertedAt      DateTime? @map("reverted_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("access_events")
}

// ---------- Planos (valores e limites editáveis pelo administrador) ----------
// Uma linha por plano (bronze, prata, ouro). `priceCents` é o preço MENSAL; semestral e anual saem dele (ver server/plans.js).
// Os valores iniciais vêm do .env (PLAN_*_PRICE) e dos limites padrão, só na primeira execução.
model PlanSetting {
  plan           String   @id // identificador do plano (ex.: bronze, prata, ouro, ou um criado pelo admin)
  name           String   @default("")
  color          String   @default("")
  sortOrder      Int      @default(0) @map("sort_order")
  priceCents     Int      @map("price_cents")
  instances      Int
  auditInstances Int      @map("audit_instances")
  contracts      Int
  portfolios     Int
  catalogProducts Int     @default(0) @map("catalog_products") // 0 = sem catálogo digital nem produtos
  auditSend      Boolean  @default(false) @map("audit_send")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("plan_settings")
}

// Código de confirmação enviado pelo WhatsApp do administrador (recuperar senha ou código PIN).
// Só o hash é guardado; vale por poucos minutos e tem limite de tentativas.
model VerificationCode {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  purpose   String // 'reset_password' | 'reset_pin'
  codeHash  String   @map("code_hash")
  attempts  Int      @default(0)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("verification_codes")
}

// ---------- Produtos / serviços e catálogo digital ----------
// Cadastro usado no portfólio e no catálogo digital. As imagens ficam em outra tabela (bytes) e são servidas por endereço próprio.
model Product {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  kind        String   @default("produto") // 'produto' | 'servico'
  name        String
  category    String   @default("")
  description String   @default("")
  priceCents  Int      @default(0) @map("price_cents")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  images ProductImage[]

  @@index([userId, category])
  @@map("products")
}

// Uma imagem por produto; com variações, de 2 a 4 imagens (cada uma com o nome da variação e, se quiser, preço próprio).
model ProductImage {
  id         Int    @id @default(autoincrement())
  productId  Int    @map("product_id")
  position   Int    @default(0)
  label      String @default("")
  priceCents Int?   @map("price_cents")
  mime       String
  data       Bytes

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
  @@map("product_images")
}

// Configuração do catálogo do usuário (entregas e frete). O token do SuperFrete fica criptografado e NUNCA vai para a página pública.
model CatalogSettings {
  userId     Int      @id @map("user_id")
  config     Json
  superfrete String? // token criptografado (utils/secret.js)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("catalog_settings")
}

// Pedido feito no catálogo. Apagado sozinho depois de 10 dias (services/maintenance.js) ou quando o usuário excluir.
model Order {
  id            Int      @id @default(autoincrement())
  userId        Int      @map("user_id")
  code          String
  customerName  String   @map("customer_name")
  customerPhone String   @map("customer_phone")
  deliveryType  String   @map("delivery_type") // 'excursao' | 'motoboy' | 'correios'
  delivery      Json
  items         Json
  subtotalCents Int      @map("subtotal_cents")
  shippingCents Int      @map("shipping_cents")
  totalCents    Int      @map("total_cents")
  notes         String   @default("")
  status        String   @default("novo") // 'novo' | 'atendido'
  createdAt     DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("orders")
}
