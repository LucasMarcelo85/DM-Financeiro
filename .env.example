# =====================================================================
#  DM Gerenciador - configuração
#  Copie este arquivo para ".env" e preencha os valores.
#  ATENÇÃO: nunca coloque senhas e chaves reais neste arquivo (ele vai para o GitHub).
#  Em produção (EasyPanel), preencha estes valores na aba "Ambiente" do serviço.
# =====================================================================

# ---------- Aplicação ----------
PORT=3001
# Endereço público do sistema (onde o usuário acessa no navegador).
# Em desenvolvimento use http://localhost:5173. Em produção, seu domínio com https.
APP_URL=https://seu-dominio.example
# IP público do servidor usado para validar o DNS de domínios próprios do portfólio.
SERVER_IP=
# Frase longa e aleatória usada para assinar o login. Troque antes de publicar.
JWT_SECRET=
# Use 1 se o sistema estiver atrás de proxy reverso (EasyPanel, Nginx, Traefik, Cloudflare).
TRUST_PROXY=0
# Fuso horário usado nos horários de envio das cobranças e lembretes.
APP_TIMEZONE=America/Sao_Paulo

# ---------- Banco de dados (PostgreSQL) ----------
# Formato: postgres://USUARIO:SENHA@HOST:5432/NOME_DO_BANCO?sslmode=disable
# Se a senha tiver caracteres especiais (@ : / ? # %), troque pelo código % (ex.: @ vira %40).
# Use um banco só para este sistema (as tabelas são criadas automaticamente).
DATABASE_URL=

# ---------- Envio automático das cobranças e lembretes ----------
SCHEDULER_ENABLED=true
# De quantos em quantos segundos o sistema procura mensagens para enviar.
SCHEDULER_INTERVAL_SECONDS=30

# ---------- Conta admin (criada automaticamente na primeira execução) ----------
ADMIN_NAME=Administrador
ADMIN_EMAIL=
ADMIN_PASSWORD=
# CPF/CNPJ do admin (opcional). Se vazio, o nome da instância do admin será "admin".
ADMIN_DOCUMENT=

# ---------- Evolution API ----------
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
# Integração usada ao criar instâncias (Evolution v2).
EVOLUTION_INTEGRATION=WHATSAPP-BAILEYS
# Pausa (ms) entre o texto e o bloco com link/Pix, para chegarem em ordem.
EVOLUTION_MESSAGE_DELAY_MS=1200

# ---------- InfinitePay: cobrança da assinatura do DM Gerenciador ----------
# InfiniteTag da plataforma, não dos lojistas do catálogo. O catálogo guarda a tag individual de cada loja no banco.
INFINITEPAY_HANDLE=
INFINITEPAY_API_URL=https://api.checkout.infinitepay.io
# APP_URL deve ser a URL pública HTTPS da aplicação para habilitar o pagamento online no catálogo.
# InfinitePay webhook (enviado pelo checkout): https://SEU_DOMINIO/api/webhooks/catalog-payments/infinitepay
# InfinitePay para catálogo usa a InfiniteTag/handle individual, cadastrada por cada lojista em Entregas e frete.
# INFINITEPAY_HANDLE acima é somente para cobranças da assinatura do sistema.

# ---------- Easypanel (Automação de Domínios) ----------
# URL base do painel, com ou sem /api no final (não inclua /trpc).
EASYPANEL_API_URL=
# Token da API do Easypanel. Mantenha este valor apenas nas variáveis do servidor.
EASYPANEL_API_KEY=
# Nomes exatos do projeto e do serviço que atende a aplicação na porta 3001.
EASYPANEL_PROJECT_NAME=
EASYPANEL_SERVICE_NAME=

# ---------- Teste grátis e planos ----------
# Valor inicial do teste grátis (depois pode ser alterado pelo admin em Gerir planos).
TRIAL_DAYS=7
# Dias de acesso liberados a cada pagamento (ou ao "dar acesso mensal" no painel admin).
ACCESS_DAYS=30
# Preço MENSAL de cada plano, em reais. O semestral cobra 5 mensalidades (6 meses de acesso)
# e o anual cobra 9 mensalidades (12 meses de acesso): esses valores são calculados sozinhos.
# Valores INICIAIS: só são usados na primeira execução, para criar os planos no banco.
# Depois disso o administrador altera valores e limites em Gerir planos (menu do admin), sem mexer neste arquivo.
PLAN_BRONZE_PRICE=34.90
PLAN_PRATA_PRICE=54.90
PLAN_OURO_PRICE=64.90

# ---------- API oficial do WhatsApp (Meta) ----------
# Só mude se precisar. A versão da Graph API usada nas chamadas.
META_API_VERSION=v21.0

# ---------- Segurança dos tokens da Meta ----------
# Chave usada para criptografar, no banco, os tokens da API oficial da Meta.
# Defina uma frase longa e FIXA: se trocar depois, os tokens salvos precisam ser cadastrados de novo.
# Se ficar vazio, usa o JWT_SECRET.
ENCRYPTION_KEY=

# ---------- Auditoria ----------
# O servidor busca as mensagens na Evolution sozinho (além do webhook). 0 desliga.
AUDIT_SYNC_SECONDS=15
# Intervalo da busca quando ninguém está com a tela aberta.
AUDIT_SYNC_IDLE_SECONDS=300
# Tamanho máximo de cada foto/vídeo/áudio guardado, em MB.
AUDIT_MEDIA_MAX_MB=20

# --- Opcionais (normalmente não precisa mexer) ---
# Limite geral de requisições por IP por minuto (padrão 600).
# RATE_LIMIT_PER_MINUTE=600
# Endereços dos serviços de CEP, mapa, rota e frete do catálogo (só para trocar de provedor ou testar).
# Configure as credenciais globais do SuperFrete no ambiente do servidor; nunca publique tokens no Git.
# SUPERFRETE_USER_AGENT identifica as chamadas da aplicação ao serviço.
SUPERFRETE_USER_AGENT=DM-Financeiro/1.0 (catalogo digital)
SUPERFRETE_TOKEN=
# VIACEP_URL=https://viacep.com.br
# NOMINATIM_URL=https://nominatim.openstreetmap.org
# OSRM_URL=https://router.project-osrm.org
# SUPERFRETE_URL=https://api.superfrete.com
# SUPERFRETE_SANDBOX_URL=https://sandbox.superfrete.com
